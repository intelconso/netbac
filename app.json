{
  "expo": {
    "name": "NETBAC",
    "slug": "netbac",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "netbac",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#10B981"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.halalapps.netbac",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.halalapps.netbac",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10B981"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": []
          },
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBFirestore"
            ]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NETBAC a besoin de la caméra pour photographier les supports."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10B981"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NETBAC a besoin d'accéder à vos photos pour ajouter une photo au produit.",
          "cameraPermission": "NETBAC a besoin de la caméra pour photographier le produit."
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.206422174526-vmrk57rrpi8b93dofs5ev5c7lqv2ab4o"
        }
      ]
    ],
    "extra": {
      "cloudinary": {
        "cloudName": "durqtcvrf",
        "uploadPreset": "netbac_products"
      },
      "revenuecat": {
        "testStoreApiKey": "test_QLhkVqzXXziSQcZyiqzAcqQBCOs",
        "androidApiKey": "goog_tgonlsKMfJPBJSWUImtVZSXdguc",
        "iosApiKey": "appl_XrllaUMfJlCaeZlDTlRkDjqleFq"
      },
      "legal": {
        "termsUrl": "",
        "privacyUrl": ""
      },
      "router": {},
      "eas": {
        "projectId": "efe5b87e-1ac3-4f2d-8b54-9d507ebf0eeb"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "fslimani"
  }
}
